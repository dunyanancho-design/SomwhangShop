@page "/admin/dashboard"
@layout SomwhangShop.Components.Layout.AdminLayout
@using SomwhangShop.Services
@using SomwhangShop.Data
@using SomwhangShop.Models
@using Microsoft.EntityFrameworkCore
@inject StatsService Stats
@inject SiteStateService SiteState
@inject IDbContextFactory<SomwhangShopContext> DbFactory
@inject IJSRuntime JSRuntime
@inject TelegramService TelegramService
@rendermode InteractiveServer

@* --- 🔊 Element สำหรับเล่นเสียงแจ้งเตือน --- *@
<audio id="adminAlertSound" src="/sound/alert.mp3" preload="auto"></audio>

<div class="container-fluid py-4 fade-in" style="max-width: 1600px;">

    @* --- 1. Header Section --- *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-speedometer2 text-primary me-2"></i>แดชบอร์ดภาพรวม</h3>
            <p class="text-muted small mb-0">ข้อมูลอัปเดตล่าสุด: @DateTime.Now.ToString("dd MMM yyyy HH:mm:ss")</p>
        </div>

        <div class="d-flex gap-3 align-items-center">
            @* ✅ สวิตช์ เปิด/ปิด ร้าน (ฟังก์ชันเดิม) *@
            <div class="form-check form-switch d-flex align-items-center bg-white px-3 py-2 rounded-pill border shadow-sm">
                <input class="form-check-input m-0 me-2" type="checkbox" role="switch" id="maintenanceSwitch"
                       checked="@SiteState.IsMaintenanceMode"
                       @onchange="ToggleMaintenance" style="cursor: pointer;">
                <label class="form-check-label fw-bold small @(SiteState.IsMaintenanceMode ? "text-danger" : "text-success")" for="maintenanceSwitch">
                    @(SiteState.IsMaintenanceMode ? "⛔ ปิดปรับปรุงร้าน" : "🟢 ร้านเปิดให้บริการ")
                </label>
            </div>

            @* ✅ ปุ่มทดสอบระบบ (ฟังก์ชันเดิม) *@
            <button class="btn btn-warning btn-sm rounded-pill shadow-sm fw-bold px-3 py-2" @onclick="SimulateTestOrder" disabled="@isSimulating">
                @if (isSimulating)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                else
                {
                    <i class="bi bi-megaphone-fill me-1"></i>
                }
                ทดสอบระบบ
            </button>

            <button class="btn btn-outline-secondary btn-sm rounded-circle p-2" @onclick="LoadData"><i class="bi bi-arrow-clockwise"></i></button>
        </div>
    </div>

    @* --- 2. Stats Cards (แสดงยอดขายจริง) --- *@
    <div class="row g-4 mb-5 animate-fade-up">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 text-white" style="background: linear-gradient(45deg, #ff5722, #ff8a65); border-radius: 15px;">
                <div class="card-body p-4">
                    <h6 class="text-white-50 text-uppercase fw-bold mb-2">ยอดขายรวม (ไม่รวมรายการทดสอบ)</h6>
                    <h2 class="fw-bold mb-0 display-5">฿@totalSales.ToString("N0")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 text-white" style="background: linear-gradient(45deg, #2e7d32, #66bb6a); border-radius: 15px;">
                <div class="card-body p-4">
                    <h6 class="text-white-50 text-uppercase fw-bold mb-2">ออเดอร์ทั้งหมด</h6>
                    <h2 class="fw-bold mb-0 display-5">@totalOrders.ToString("N0")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 text-white" style="background: linear-gradient(45deg, #0288d1, #29b6f6); border-radius: 15px;">
                <div class="card-body p-4">
                    <h6 class="text-white-50 text-uppercase fw-bold mb-2">คนเข้าเว็บวันนี้ (ข้อมูลจริง)</h6>
                    <h2 class="fw-bold mb-0 display-5">@todayVisits.ToString("N0")</h2>
                </div>
            </div>
        </div>
    </div>

    @* --- 3. Charts & Product Analytics --- *@
    <div class="row g-4 mb-4">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-graph-up text-primary me-2"></i>สถิติคนเข้าเว็บ (7 วันล่าสุด)</h6>
                </div>
                <div class="card-body"><canvas id="visitsChart" style="max-height: 300px;"></canvas></div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-cart-check text-success me-2"></i>อันดับยอดขาย (จำนวนชิ้น)</h6>
                </div>
                <div class="list-group list-group-flush">
                    @foreach (var item in topProductSales)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span class="text-truncate small">@item.Name</span>
                            <span class="badge bg-success rounded-pill">@item.TotalSold ชิ้น</span>
                        </div>
                    }
                    @if (!topProductSales.Any())
                    {
                        <div class="p-3 text-center text-muted small">ยังไม่มีข้อมูลการขาย</div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* --- 4. Affiliates & Top Views --- *@
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-trophy text-warning me-2"></i>สินค้าที่มีคนดูสูงสุด (Views)</h6>
                </div>
                <div class="list-group list-group-flush">
                    @foreach (var item in topProducts)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span class="text-truncate small">@item.Name</span>
                            <span class="badge bg-info text-dark rounded-pill">@item.ViewCount วิว</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-8">
            @* ✅ เปลี่ยนจากออเดอร์ล่าสุดเป็น: อันดับนายหน้า (Top Affiliates) *@
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-people text-primary me-2"></i>อันดับนายหน้า (Top Affiliates)</h6>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-center">
                        <thead class="bg-light small">
                            <tr>
                                <th class="text-start ps-4">รหัสนายหน้า (Affiliate ID)</th>
                                <th class="text-end pe-4">จำนวนการเข้าชมรวม (Clicks)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var aff in topAffiliates)
                            {
                                <tr>
                                    <td class="text-start ps-4"><div class="fw-bold small">@aff.AffiliateId</div></td>
                                    <td class="text-end pe-4 fw-bold text-primary">@aff.TotalVisits.ToString("N0") ครั้ง</td>
                                </tr>
                            }
                            @if (!topAffiliates.Any())
                            {
                                <tr>
                                    <td colspan="2" class="p-4 text-center text-muted small">ยังไม่มีข้อมูลสถิตินายหน้า</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private decimal totalSales = 0;
    private int totalOrders = 0;
    private int todayVisits = 0;
    private List<dynamic> topProducts = new();
    private List<dynamic> topProductSales = new();
    private List<dynamic> topAffiliates = new();
    private List<Order> recentOrders = new(); // ยังคงโหลดไว้ใน Logic ได้หากต้องการใช้งานอื่น
    private bool isSimulating = false;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try
        {
            using var context = DbFactory.CreateDbContext();
            // 1. คำนวณยอดขายรวม (ไม่รวม TEST)
            totalSales = await context.Orders.Where(o => o.Status != "ยกเลิก" && o.Status != "TEST").SumAsync(o => o.TotalAmount);
            totalOrders = await context.Orders.CountAsync(o => o.Status != "TEST");

            // 2. ดึงข้อมูลจริงจาก StatsService [cite: 219, 221]
            todayVisits = Stats.GetTodayVisits();
            topProducts = Stats.GetTopProducts().ToList();
            topProductSales = Stats.GetProductSalesStats().ToList();
            topAffiliates = Stats.GetTopAffiliates().ToList(); // ดึงข้อมูลอันดับนายหน้า

            recentOrders = await context.Orders.OrderByDescending(o => o.OrderDate).Take(8).ToListAsync();

            // 3. วาดกราฟ [cite: 223]
            var graphData = Stats.GetDailyVisits().ToList();
            if (graphData.Any())
            {
                var labels = graphData.Select(d => ((DateTime)d.VisitDate).ToString("dd/MM")).ToArray();
                var values = graphData.Select(d => (int)d.VisitCount).ToArray();
                await JSRuntime.InvokeVoidAsync("renderVisitChart", labels, values);
            }
        }
        catch (Exception ex) { Console.WriteLine($"Load Error: {ex.Message}"); }
    }

    private async Task ToggleMaintenance(ChangeEventArgs e) => await SiteState.SetMaintenanceModeAsync((bool)(e.Value ?? false));

    private async Task SimulateTestOrder()
    {
        isSimulating = true;
        try
        {
            using var context = DbFactory.CreateDbContext();
            var testOrder = new Order
            {
                OrderId = "TEST-" + DateTime.Now.ToString("HHmmss"),
                CustomerName = "ระบบทดสอบ",
                TotalAmount = 999,
                Status = "TEST",
                OrderDate = DateTime.Now
            };
            context.Orders.Add(testOrder);
            await context.SaveChangesAsync();

            await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('adminAlertSound').play()");
            await TelegramService.SendOrderNotificationAsync(testOrder);
            await LoadData();
        }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", ex.Message); }
        finally { isSimulating = false; }
    }
}