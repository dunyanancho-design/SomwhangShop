@page "/"
@using SomwhangShop.Models
@using SomwhangShop.Services
@inject NavigationManager NavManager
@inject ShopService ShopService
@rendermode InteractiveServer

<PageTitle>ร้าน สมหวัง ลูกชิ้นเนื้อแท้</PageTitle>

@* ✅ ส่วนหัว (Header) *@
<div class="header-section text-white mb-4 shadow-sm" style="background: linear-gradient(135deg, #0d6efd, #0dcaf0);">
    <div class="container py-3">
        <div class="row align-items-center g-3">

            @* โลโก้และชื่อร้าน *@
            <div class="col-lg-5 d-flex align-items-center gap-3 mb-1 mb-lg-0">
                <div class="logo-wrapper bg-white p-1 rounded-circle shadow-sm">
                    <img src="images/logo.jpg" alt="Somwhang Logo" class="rounded-circle" width="60" height="60">
                </div>
                <div>
                    <h1 class="h5 fw-bold mb-0 text-shadow">ร้านสมหวังลูกชิ้นเนื้อแท้</h1>
                    <p class="mb-0 text-white-50 small opacity-75">"สด สะอาด อร่อย... มาตรฐานที่คุณวางใจ"</p>
                </div>
            </div>

            @* ปุ่มเมนูลัด (Tracking & Contact) *@
            <div class="col-lg-7 text-lg-end">
                <div class="d-inline-flex gap-2 flex-wrap justify-content-lg-end">

                    @* 🚚 ปุ่มติดตามพัสดุ *@
                    <a href="tracking" class="btn btn-sm btn-white text-dark px-3 shadow-sm rounded-pill fw-bold d-inline-flex align-items-center gap-1 hover-scale text-decoration-none">
                        <i class="bi bi-truck text-primary"></i> ติดตามสินค้า
                    </a>

                    @* 📞 ปุ่มเบอร์โทร *@
                    <a href="tel:044000349" class="btn btn-sm btn-white text-primary px-3 shadow-sm rounded-pill fw-bold d-inline-flex align-items-center gap-1 hover-scale text-decoration-none">
                        <i class="bi bi-telephone-fill"></i> โทรเลย
                    </a>

                    @* 📘 ปุ่ม Facebook *@
                    <a href="https://www.facebook.com/profile.php?id=100083003817106" target="_blank"
                       class="btn btn-sm btn-white text-facebook px-3 shadow-sm rounded-pill fw-bold d-inline-flex align-items-center gap-1 hover-scale text-decoration-none">
                        <i class="bi bi-facebook"></i> Facebook
                    </a>

                    @* 💚 ปุ่ม Line OA *@
                    <a href="https://line.me/ti/p/~@LineId" target="_blank"
                       class="btn btn-sm btn-white text-success px-3 shadow-sm rounded-pill fw-bold d-inline-flex align-items-center gap-1 hover-scale text-decoration-none">
                        <i class="bi bi-line fs-6"></i> Line OA
                    </a>

                    @if (!string.IsNullOrEmpty(RefId))
                    {
                        <div class="badge bg-warning text-dark px-2 py-1 shadow-sm d-flex align-items-center rounded-pill border border-white small">
                            <i class="bi bi-star-fill me-1"></i> แนะนำโดย: @RefId
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@* ✅ ส่วนแนะนำวิธีการสั่งซื้อ (How to Order) *@
<div class="container mb-5 fade-in">
    <div class="card border-0 shadow-sm bg-white rounded-4 overflow-hidden">
        <div class="card-body p-4">
            <h6 class="fw-bold text-center text-secondary mb-4 text-uppercase ls-1">
                <i class="bi bi-magic me-2 text-warning"></i>4 ขั้นตอนง่ายๆ สั่งความอร่อย
            </h6>
            <div class="row g-4 text-center position-relative">

                @* Step 1 *@
                <div class="col-6 col-md-3">
                    <div class="step-icon mx-auto mb-2 bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-cart-plus-fill fs-4"></i>
                    </div>
                    <h6 class="fw-bold small mb-1">1. เลือกสินค้า</h6>
                    <p class="text-muted small m-0" style="font-size: 0.75rem;">กดเมนูลงตะกร้า</p>
                </div>

                @* Step 2 *@
                <div class="col-6 col-md-3">
                    <div class="step-icon mx-auto mb-2 bg-info bg-opacity-10 text-info">
                        <i class="bi bi-pencil-square fs-4"></i>
                    </div>
                    <h6 class="fw-bold small mb-1">2. ระบุที่อยู่</h6>
                    <p class="text-muted small m-0" style="font-size: 0.75rem;">ชื่อ-ที่อยู่-เบอร์โทร</p>
                </div>

                @* Step 3 *@
                <div class="col-6 col-md-3">
                    <div class="step-icon mx-auto mb-2 bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-qr-code-scan fs-4"></i>
                    </div>
                    <h6 class="fw-bold small mb-1">3. โอน & แนบสลิป</h6>
                    <p class="text-muted small m-0" style="font-size: 0.75rem;">ชำระเงินและแจ้งโอน</p>
                </div>

                @* Step 4 *@
                <div class="col-6 col-md-3">
                    <div class="step-icon mx-auto mb-2 bg-success bg-opacity-10 text-success">
                        <i class="bi bi-box2-heart-fill fs-4"></i>
                    </div>
                    <h6 class="fw-bold small mb-1">4. รอรับสินค้า</h6>
                    <p class="text-muted small m-0" style="font-size: 0.75rem;">ส่งไว ถึงหน้าบ้าน</p>
                </div>

            </div>
        </div>
    </div>
</div>

@* ✅ ส่วนเลือกร้านค้า (Shop List) *@
<div class="container pb-5">
    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
        <h6 class="fw-bold text-dark m-0">
            <i class="bi bi-shop-window me-2 text-primary"></i>เลือกร้านค้าบริการ
        </h6>
        <span class="badge bg-light text-muted border small rounded-pill px-3">
            @shopList.Count ร้านค้า
        </span>
    </div>

    <div class="row g-3">
        @foreach (var shop in shopList)
        {
            <div class="col-xl-3 col-lg-4 col-md-6 col-6">
                <div class="card h-100 shadow-sm border-0 shop-card hover-lift rounded-4 overflow-hidden">
                    <div class="position-relative">
                        @if (!string.IsNullOrEmpty(shop.ImageUrl))
                        {
                            <img src="@shop.ImageUrl" class="card-img-top shop-img" alt="@shop.Name">
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center text-secondary shop-img">
                                <i class="bi bi-shop fs-1 opacity-25"></i>
                            </div>
                        }
                        <div class="position-absolute top-0 end-0 m-2">
                            <span class="badge bg-success shadow-sm rounded-pill px-2" style="font-size: 0.65rem;">OPEN</span>
                        </div>
                    </div>

                    <div class="card-body p-3 d-flex flex-column text-center">
                        <h6 class="card-title fw-bold text-dark text-truncate mb-1">@shop.Name</h6>
                        <p class="card-text text-muted small flex-grow-1 line-clamp-2 mb-3 d-none d-sm-block" style="font-size: 0.8rem;">
                            @shop.Description
                        </p>

                        @if (!string.IsNullOrEmpty(shop.LinkUrl))
                        {
                            @* เรียกฟังก์ชัน GetShopLink ที่เราแก้แล้ว *@
                            <a href="@GetShopLink(shop.LinkUrl)" class="btn btn-sm btn-outline-primary w-100 rounded-pill fw-bold action-btn">
                                เข้าสู่ร้านค้า
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-light w-100 rounded-pill border" disabled>
                                เร็วๆ นี้
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* 🎨 Custom Styles */
    .text-facebook {
        color: #1877F2 !important;
    }

    .shop-img {
        height: 150px;
        object-fit: cover;
    }

    @@media (max-width: 576px) {
        .shop-img {
            height: 110px;
        }
    }

    .btn-white {
        background-color: white;
        border: 1px solid rgba(0,0,0,0.05);
        transition: all 0.2s ease;
    }

        .btn-white:hover {
            background-color: #f8f9fa;
            transform: translateY(-1px);
        }

    .step-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.3s;
    }

        .step-icon:hover {
            transform: scale(1.1);
        }

    .hover-lift {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .hover-lift:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
        }

    .text-shadow {
        text-shadow: 0 2px 4px rgba(0,0,0,0.15);
    }

    .ls-1 {
        letter-spacing: 1px;
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .fade-in {
        animation: fadeIn 0.8s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "ref")]
    public string? RefId { get; set; }

    private string LineId = "@282vldos";

    // ระบุชื่อเต็ม SomwhangShop.Models.Shop เพื่อกันระบบสับสน
    List<SomwhangShop.Models.Shop> shopList = new List<SomwhangShop.Models.Shop>();

    protected override void OnInitialized()
    {
        shopList = ShopService.GetShops(activeOnly: true);
    }

    private string GetShopLink(string path)
    {
        // ✅ แก้ไข: เติม "shop/" นำหน้า slug ที่ได้จาก DB เสมอ
        // ผลลัพธ์: fish_sauce -> shop/fish_sauce
        string fullPath = $"shop/{path}";

        return string.IsNullOrEmpty(RefId) ? fullPath : $"{fullPath}?ref={RefId}";
    }
}