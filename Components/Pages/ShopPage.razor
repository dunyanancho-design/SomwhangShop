@page "/shop/{ShopUrl}"
@using SomwhangShop.Models
@using SomwhangShop.Services
@using SomwhangShop.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SomwhangShopContext> DbFactory
@inject CartService CartService
@inject StatsService Stats
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>@title</PageTitle>

@* --- 1. Toast Notification (แจ้งเตือนแบบลื่นไหล ไม่ขัดจังหวะ) --- *@
@if (showToast)
{
    <div class="toast-container position-fixed top-0 start-50 translate-middle-x p-3" style="z-index: 2000;">
        <div class="toast show align-items-center text-white bg-success border-0 shadow-lg animate-toast" role="alert">
            <div class="d-flex">
                <div class="toast-body fs-6">
                    <i class="bi bi-check-circle-fill me-2"></i> @toastMessage
                </div>
            </div>
        </div>
    </div>
}

@if (currentShop == null)
{
    @if (isLoading)
    {
        <div class="vh-100 d-flex flex-column align-items-center justify-content-center">
            <div class="spinner-grow text-primary mb-3" role="status"></div>
            <p class="text-muted animate-pulse">กำลังจัดเตรียมหน้าร้าน...</p>
        </div>
    }
    else
    {
        <div class="vh-100 d-flex flex-column align-items-center justify-content-center text-center">
            <i class="bi bi-shop-window display-1 text-muted opacity-25 mb-3"></i>
            <h3 class="fw-bold text-dark">ไม่พบร้านค้านี้</h3>
            <p class="text-muted mb-4">ร้านค้าที่คุณตามหาอาจปิดปรับปรุงหรือไม่มีอยู่จริง</p>
            <a href="/" class="btn btn-outline-primary rounded-pill px-4 hover-scale">กลับหน้าหลัก</a>
        </div>
    }
}
else
{
    @* --- 2. Shop Header (Modern Gradient) --- *@
    <div class="shop-header text-white position-relative overflow-hidden mb-5">
        <div class="container position-relative py-5" style="z-index: 2;">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <span class="badge bg-white bg-opacity-25 backdrop-blur rounded-pill mb-2 px-3">
                        <i class="bi bi-patch-check-fill me-1"></i> ร้านค้าทางการ
                    </span>
                    <h1 class="fw-bold display-5 mb-2 text-shadow">@currentShop.Name</h1>
                    <p class="text-white-50 lead fs-6 mb-3">@currentShop.Description</p>

                    @* เงื่อนไขส่งฟรี *@
                    <div class="d-inline-flex align-items-center bg-white bg-opacity-10 rounded-3 px-3 py-2 border border-white border-opacity-25">
                        <i class="bi bi-truck fs-4 me-3"></i>
                        <div>
                            <div class="small text-white-50 text-uppercase" style="font-size: 0.7rem;">โปรโมชั่นส่งฟรี</div>
                            <div class="fw-bold">
                                ครบ @(currentShop.CalcType == "Quantity" ? $"{currentShop.FreeThreshold:N0} ชิ้น" : $"{currentShop.FreeThreshold:N1} กก.")
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-center d-none d-md-block">
                    @if (!string.IsNullOrEmpty(currentShop.ImageUrl))
                    {
                        <img src="@currentShop.ImageUrl" class="shop-logo shadow-lg" />
                    }
                </div>
            </div>
        </div>
        @* Background Decor *@
        <div class="bg-circle-1"></div>
        <div class="bg-circle-2"></div>
    </div>

    @* --- 3. Product Grid --- *@
    <div class="container pb-5" style="min-height: 60vh;">
        @if (products.Count == 0)
        {
            <div class="text-center py-5 bg-light rounded-4 border-dashed mx-3">
                <i class="bi bi-box2-heart display-1 text-muted opacity-50"></i>
                <h4 class="mt-4 text-muted">สินค้ากำลังเดินทางมา</h4>
                <p class="text-muted small">อดใจรออีกนิด ทางร้านกำลังเติมสต็อกครับ</p>
            </div>
        }
        else
        {
            <div class="row g-3 g-md-4">
                @foreach (var product in products)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="card h-100 border-0 shadow-sm product-card animate-fade-up">

                            @* Product Image & Badge *@
                            <div class="card-img-wrapper position-relative bg-light">
                                <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name"
                                     onerror="this.src='/images/no-image.png';" />

                                @* 🔴 Logic แสดงผล Stock *@
                                <div class="position-absolute top-0 end-0 p-2">
                                    @if (product.StockQuantity <= 0)
                                    {
                                        <span class="badge bg-secondary bg-opacity-75 backdrop-blur shadow-sm">สินค้าหมด</span>
                                    }
                                    else if (product.StockQuantity < 10)
                                    {
                                        <span class="badge bg-warning text-dark bg-opacity-90 backdrop-blur shadow-sm">เหลือ @product.StockQuantity</span>
                                    }
                                </div>
                            </div>

                            <div class="card-body d-flex flex-column p-3">
                                <small class="text-muted x-small mb-1">@product.Category</small>
                                <h6 class="card-title fw-bold text-dark mb-1 line-clamp-2" style="height: 2.5em;">@product.Name</h6>

                                <div class="mt-auto pt-3 d-flex align-items-end justify-content-between">
                                    <div>
                                        <div class="text-primary fw-bold fs-5">฿@product.Price.ToString("N0")</div>
                                        @if (product.StockQuantity > 0)
                                        {
                                            <small class="text-success x-small"><i class="bi bi-box-seam me-1"></i>พร้อมส่ง</small>
                                        }
                                        else
                                        {
                                            <small class="text-danger x-small"><i class="bi bi-x-circle me-1"></i>สินค้าหมด</small>
                                        }
                                    </div>

                                    @* ปุ่มสั่งซื้อ (Disable ถ้าของหมด) *@
                                    <button class="btn btn-icon rounded-circle shadow-sm @(product.StockQuantity > 0 ? "btn-primary hover-rotate" : "btn-secondary disabled")"
                                            @onclick="() => AddToCart(product)"
                                            disabled="@(product.StockQuantity <= 0)">
                                        <i class="bi bi-cart-plus-fill"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @* --- 4. Floating Cart (Sticky) --- *@
    <div class="fixed-bottom p-3 pointer-events-none">
        <div class="container d-flex justify-content-end pointer-events-auto">
            <a href="cart" class="btn-float-cart shadow-lg animate-bounce">
                <i class="bi bi-basket2-fill fs-4"></i>
                @if (CartService.GetItemCount() > 0)
                {
                    <span class="cart-badge animate-pop">@CartService.GetItemCount()</span>
                }
            </a>
        </div>
    </div>

    @* --- 5. Footer (ตามที่ขอ) --- *@
    /*
    <div class="mt-5">
        <SomwhangShop.Components.Pages.TrustFooter />
    </div>
    */
}

<style>
    /* UX/UI Enhancements */
    :root {
        --shop-gradient: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%);
    }

    .shop-header {
        background: var(--shop-gradient);
        border-radius: 0 0 2.5rem 2.5rem;
        box-shadow: 0 10px 30px -10px rgba(79, 70, 229, 0.3);
    }

    .shop-logo {
        width: 120px;
        height: 120px;
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid rgba(255,255,255,0.3);
    }

    .bg-circle-1, .bg-circle-2 {
        position: absolute;
        border-radius: 50%;
        background: white;
        opacity: 0.05;
    }

    .bg-circle-1 {
        width: 300px;
        height: 300px;
        top: -100px;
        right: -50px;
    }

    .bg-circle-2 {
        width: 200px;
        height: 200px;
        bottom: -50px;
        left: 10%;
    }

    /* Product Cards */
    .product-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        background: #fff;
        overflow: hidden;
        border-radius: 1rem;
    }

        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04) !important;
        }

    .card-img-wrapper {
        height: 180px;
        overflow: hidden;
    }

    .card-img-top {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .product-card:hover .card-img-top {
        transform: scale(1.05);
    }

    /* Buttons & Badges */
    .btn-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s;
    }

    .hover-rotate:hover i {
        transform: scale(1.2) rotate(-10deg);
        transition: 0.3s;
    }

    .backdrop-blur {
        backdrop-filter: blur(4px);
    }

    /* Floating Cart */
    .pointer-events-none {
        pointer-events: none;
    }

    .pointer-events-auto {
        pointer-events: auto;
    }

    .btn-float-cart {
        background: #0d6efd;
        color: white;
        width: 65px;
        height: 65px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        transition: transform 0.2s;
    }

        .btn-float-cart:hover {
            transform: scale(1.1);
            color: white;
        }

    .cart-badge {
        position: absolute;
        top: 0;
        right: 0;
        background: #dc3545;
        color: white;
        border-radius: 50%;
        width: 24px;
        height: 24px;
        font-size: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid white;
    }

    /* Animations */
    .animate-fade-up {
        animation: fadeUp 0.6s ease-out forwards;
        opacity: 0;
    }

    .animate-toast {
        animation: slideDown 0.4s cubic-bezier(0.68, -0.55, 0.27, 1.55);
    }

    .animate-pop {
        animation: pop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes slideDown {
        from {
            transform: translateY(-100%);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    @@keyframes pop {
        0% {
            transform: scale(0);
        }

        80% {
            transform: scale(1.2);
        }

        100% {
            transform: scale(1);
        }
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .x-small {
        font-size: 0.75rem;
    }
</style>

@code {
    [Parameter] public string ShopUrl { get; set; } = "";
    private Shop? currentShop;
    private List<Product> products = new List<Product>();
    private bool isLoading = true;
    private string title = "กำลังโหลด...";

    // Toast logic
    private bool showToast = false;
    private string toastMessage = "";

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        using var context = DbFactory.CreateDbContext();

        currentShop = await context.Shops.FirstOrDefaultAsync(s => s.LinkUrl == ShopUrl && s.IsActive);
        if (currentShop != null)
        {
            title = currentShop.Name + " - ช้อปปิ้งออนไลน์";
            // ✅ ดึง StockQuantity มาด้วย
            products = await context.Products
                                    .Where(p => p.ShopId == currentShop.Id && p.IsActive)
                                    .OrderByDescending(p => p.StockQuantity > 0) // เอาของมีสต็อกขึ้นก่อน
                                    .ToListAsync();

            foreach (var product in products)
            {
                Stats.RecordProductView(product.Id);
            }
        }
        else { title = "ไม่พบร้านค้า"; }
        isLoading = false;
    }

    private async Task AddToCart(Product product)
    {
        // ✅ ตรวจสอบสต็อกก่อนหยิบใส่ตะกร้า
        if (product.StockQuantity > 0)
        {
            CartService.AddItem(product);
            await ShowToast($"เพิ่ม \"{product.Name}\" ลงตะกร้าแล้ว");
        }
    }

    // ✅ ฟังก์ชันแสดง Toast แบบ Custom (ไม่ใช้ Alert)
    private async Task ShowToast(string message)
    {
        toastMessage = message;
        showToast = true;
        StateHasChanged();
        await Task.Delay(3000); // แสดง 3 วินาทีแล้วหายไป
        showToast = false;
        StateHasChanged();
    }
}