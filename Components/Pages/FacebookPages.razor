@page "/admin/facebook"
@layout SomwhangShop.Components.Layout.AdminLayout
@using SomwhangShop.Models
@using SomwhangShop.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SomwhangShopContext> DbFactory
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<div class="container-fluid py-4" style="max-width: 1600px;">

    @* --- Header Section --- *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-primary mb-0"><i class="bi bi-robot me-2"></i>ระบบตอบกลับอัตโนมัติ</h3>
            <p class="text-muted small mb-0">จัดการการเชื่อมต่อเพจและตั้งค่าคำตอบ (Auto-Reply)</p>
        </div>
        <button class="btn btn-primary rounded-pill shadow-sm px-4" @onclick="NewPage">
            <i class="bi bi-plus-lg me-2"></i>เชื่อมต่อเพจใหม่
        </button>
    </div>

    @* --- Webhook Info Section --- *@
    <div class="card shadow-sm border-0 rounded-4 mb-4 bg-primary bg-opacity-10">
        <div class="card-body d-flex flex-wrap align-items-center justify-content-between py-3">
            <div class="d-flex align-items-center mb-2 mb-md-0">
                <div class="bg-white p-2 rounded-circle text-primary me-3 shadow-sm">
                    <i class="bi bi-link-45deg fs-4"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-0 text-primary">การตั้งค่า Webhook</h6>
                    <small class="text-muted">ค่าสำหรับนำไปกรอกใน Facebook Developer</small>
                </div>
            </div>

            <div class="d-flex gap-3">
                <div class="input-group shadow-sm">
                    <span class="input-group-text bg-white border-0 fw-bold small text-muted">URL</span>
                    <input type="text" class="form-control border-0 font-monospace small bg-white" value="https://somwhangshop.com/api/webhook" readonly id="webhookUrl" />
                    <button class="btn btn-light bg-white border-0 text-primary" @onclick='() => CopyToClipboard("webhookUrl")' title="คัดลอก">
                        <i class="bi bi-clipboard"></i>
                    </button>
                </div>

                <div class="input-group shadow-sm">
                    <span class="input-group-text bg-white border-0 fw-bold small text-muted">Token</span>
                    <input type="text" class="form-control border-0 font-monospace small bg-white" value="SomwhangSecret" readonly id="verifyToken" />
                    <button class="btn btn-light bg-white border-0 text-primary" @onclick='() => CopyToClipboard("verifyToken")' title="คัดลอก">
                        <i class="bi bi-clipboard"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 h-100">
        @* --- Left Column: Page List --- *@
        <div class="col-lg-3 col-md-4">
            <div class="card shadow-sm border-0 rounded-4 h-100 overflow-hidden">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-secondary text-uppercase small ls-1">
                        <i class="bi bi-shop me-2"></i>ร้านค้าของคุณ
                    </h6>
                    <button class="btn btn-sm btn-light text-primary rounded-circle border" @onclick="NewPage" title="เพิ่มเพจ">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </div>
                <div class="list-group list-group-flush custom-scrollbar" style="max-height: 70vh; overflow-y: auto;">
                    @foreach (var p in pages)
                    {
                        <button class="list-group-item list-group-item-action py-3 border-bottom @(selectedPage?.Id == p.Id ? "active-page" : "")"
                                @onclick="() => SelectPage(p)">
                            <div class="d-flex w-100 justify-content-between align-items-center mb-1">
                                <strong class="text-truncate">@p.AdminNote</strong>
                                @if (p.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success rounded-pill" style="font-size: 0.6rem;">● Online</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill" style="font-size: 0.6rem;">○ Offline</span>
                                }
                            </div>
                            <small class="d-block opacity-75 font-monospace text-truncate mb-2" style="font-size: 0.75rem;">
                                ID: @p.PageId
                            </small>
                            <div class="d-flex align-items-center small opacity-50">
                                <i class="bi bi-chat-dots me-1"></i> @p.AutoReplyItems?.Count คำตอบ
                            </div>
                        </button>
                    }
                    @if (!pages.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-shop-window display-6 opacity-25"></i>
                            <p class="mt-3 small">ยังไม่มีเพจที่เชื่อมต่อ</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* --- Right Column: Workspace --- *@
        <div class="col-lg-9 col-md-8">
            @if (selectedPage != null)
            {
                <div class="card shadow-sm border-0 rounded-4 h-100 fade-in">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                        <div class="d-flex align-items-center">
                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-3">
                                <i class="bi bi-facebook fs-4"></i>
                            </div>
                            <div>
                                <h5 class="mb-0 fw-bold">@selectedPage.AdminNote</h5>
                                <small class="text-muted font-monospace user-select-all">ID: @selectedPage.PageId</small>
                            </div>
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            <div class="form-check form-switch me-2" title="เปิด/ปิดบอท">
                                <input class="form-check-input" type="checkbox" checked="@selectedPage.IsActive"
                                       @onchange="TogglePageStatus" style="cursor: pointer; transform: scale(1.2);">
                            </div>

                            <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" @onclick="EditPageToken">
                                <i class="bi bi-key me-1"></i> Token
                            </button>
                            <button class="btn btn-outline-danger btn-sm rounded-pill px-3" @onclick="DeletePage">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>

                    <div class="card-body bg-light bg-opacity-25 p-4">
                        <div class="d-flex justify-content-between align-items-end mb-3">
                            <div>
                                <h6 class="fw-bold text-dark mb-1">รายการคำตอบอัตโนมัติ</h6>
                                <p class="small text-muted mb-0">เมื่อลูกค้าพิมพ์คำเหล่านี้ บอทจะตอบกลับตามที่ตั้งไว้</p>
                            </div>
                            <button class="btn btn-primary btn-sm rounded-pill shadow-sm px-3" @onclick="NewRule">
                                <i class="bi bi-plus-circle me-1"></i> เพิ่มคำตอบ
                            </button>
                        </div>

                        @if (selectedPage.AutoReplyItems != null && selectedPage.AutoReplyItems.Any())
                        {
                            <div class="table-responsive bg-white rounded-3 shadow-sm border">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light text-secondary small text-uppercase">
                                        <tr>
                                            <th class="ps-4" style="width: 30%;">คีย์เวิร์ด</th>
                                            <th style="width: 50%;">คำตอบ</th>
                                            <th class="text-end pe-4">จัดการ</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var rule in selectedPage.AutoReplyItems)
                                        {
                                            <tr>
                                                <td class="ps-4">
                                                    @foreach (var k in rule.Keywords.Split(','))
                                                    {
                                                        <span class="badge bg-info bg-opacity-10 text-dark border border-info border-opacity-25 me-1 mb-1">
                                                            @k.Trim()
                                                        </span>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="text-truncate text-secondary" style="max-width: 400px;">
                                                        @rule.ReplyMessage
                                                    </div>
                                                </td>
                                                <td class="text-end pe-4">
                                                    <button class="btn btn-sm btn-link text-primary p-0 me-2" @onclick="() => EditRule(rule)">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => DeleteRule(rule)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5 border rounded-3 bg-white border-dashed">
                                <i class="bi bi-chat-quote display-6 text-muted opacity-25"></i>
                                <p class="mt-3 text-muted">ยังไม่มีชุดคำตอบสำหรับเพจนี้</p>
                                <button class="btn btn-sm btn-outline-primary" @onclick="NewRule">สร้างคำตอบแรก</button>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="h-100 d-flex align-items-center justify-content-center border rounded-4 bg-light text-secondary fade-in" style="min-height: 400px;">
                    <div class="text-center">
                        <i class="bi bi-arrow-left-circle display-4 mb-3 d-block opacity-25"></i>
                        <h5>เลือกเพจทางซ้ายมือ</h5>
                        <p class="small">เพื่อจัดการชุดคำตอบของแต่ละร้าน</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@* --- Modal Edit Page (Token) --- *@
@if (isEditingPage)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            @* ใช้ modal-lg ให้กว้างขึ้น *@
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">@(editingPage.Id == 0 ? "เพิ่มเพจใหม่" : "ตั้งค่าเพจ")</h5>
                    <button type="button" class="btn-close" @onclick="() => isEditingPage = false"></button>
                </div>
                <EditForm Model="editingPage" OnValidSubmit="SavePage">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-bold">ชื่อร้าน (Admin Note)</label>
                            <InputText @bind-Value="editingPage.AdminNote" class="form-control" placeholder="เช่น สาขาร่มเกล้า" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Page ID</label>
                            <InputText @bind-Value="editingPage.PageId" class="form-control" placeholder="ระบุ Page ID" />
                        </div>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between">
                                <label class="form-label small fw-bold">Page Access Token</label>
                                <span class="text-muted small" style="font-size: 0.75rem;">(Token มีความยาวมาก กรุณาใส่ให้ครบ)</span>
                            </div>

                            @* ✅ แก้ตรงนี้: เพิ่ม rows เป็น 12 บรรทัด *@
                            <InputTextArea @bind-Value="editingPage.PageAccessToken"
                                           class="form-control font-monospace small bg-light"
                                           rows="12"
                                           placeholder="EAA..."
                                           style="min-height: 200px;" />
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-light" @onclick="() => isEditingPage = false">ยกเลิก</button>
                        <button type="submit" class="btn btn-primary px-4">บันทึก</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@* --- Modal Edit Rule --- *@
@if (isEditingRule)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold"><i class="bi bi-chat-dots-fill text-primary me-2"></i>@(editingRule.Id == 0 ? "เพิ่มคำตอบใหม่" : "แก้ไขคำตอบ")</h5>
                    <button type="button" class="btn-close" @onclick="() => isEditingRule = false"></button>
                </div>
                <EditForm Model="editingRule" OnValidSubmit="SaveRule">
                    <DataAnnotationsValidator />
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">คีย์เวิร์ด <span class="text-danger">*</span></label>
                            <div class="text-muted small mb-2">ลูกค้าพิมพ์คำเหล่านี้ บอทถึงจะตอบ (คั่นด้วยจุลภาค ,)</div>
                            <InputText @bind-Value="editingRule.Keywords" class="form-control form-control-lg" placeholder="เช่น ราคา, เท่าไหร่, สนใจ" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">ข้อความตอบกลับ <span class="text-danger">*</span></label>
                            <InputTextArea @bind-Value="editingRule.ReplyMessage" class="form-control" rows="5" placeholder="พิมพ์ข้อความตอบกลับที่นี่..." />
                        </div>
                    </div>
                    <div class="modal-footer border-0 bg-light">
                        <button type="button" class="btn btn-link text-secondary text-decoration-none" @onclick="() => isEditingRule = false">ยกเลิก</button>
                        <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">บันทึกคำตอบ</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<style>
    .active-page {
        background-color: #f0f7ff !important;
        border-left: 4px solid #0d6efd !important;
        color: #0d6efd;
    }

        .active-page .text-muted {
            color: #6c757d !important;
        }

    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #ccc;
        border-radius: 3px;
    }

    .fade-in {
        animation: fadeIn 0.3s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .border-dashed {
        border-style: dashed !important;
    }
</style>

<script>
    window.copyToClipboard = (id) => {
        var copyText = document.getElementById(id);
        copyText.select();
        copyText.setSelectionRange(0, 99999);
        navigator.clipboard.writeText(copyText.value);
        // alert("คัดลอกเรียบร้อย"); // ลบ Alert ออกถ้าไม่อยากให้เด้ง
    }
</script>

@code {
    private List<FacebookPageConfig> pages = new();
    private FacebookPageConfig? selectedPage;
    private FacebookPageConfig editingPage = new();
    private AutoReplyItem editingRule = new();
    private bool isEditingPage = false;
    private bool isEditingRule = false;

    protected override void OnInitialized() { LoadData(); }

    void LoadData()
    {
        try
        {
            using var context = DbFactory.CreateDbContext();
            pages = context.FacebookPageConfigs.Include(p => p.AutoReplyItems).OrderByDescending(p => p.LastUpdated).ToList();
            if (selectedPage != null) selectedPage = pages.FirstOrDefault(p => p.Id == selectedPage.Id);
        }
        catch (Exception ex) { Console.WriteLine($"Error: {ex.Message}"); }
    }

    void SelectPage(FacebookPageConfig page) { selectedPage = page; }
    void NewPage() { editingPage = new FacebookPageConfig { IsActive = true }; isEditingPage = true; }
    void EditPageToken() { editingPage = new FacebookPageConfig { Id = selectedPage.Id, AdminNote = selectedPage.AdminNote, PageId = selectedPage.PageId, PageAccessToken = selectedPage.PageAccessToken, IsActive = selectedPage.IsActive }; isEditingPage = true; }

    async Task SavePage()
    {
        using var context = DbFactory.CreateDbContext();
        if (editingPage.Id == 0) { editingPage.LastUpdated = DateTime.Now; context.FacebookPageConfigs.Add(editingPage); }
        else
        {
            var existing = context.FacebookPageConfigs.Find(editingPage.Id);
            if (existing != null) { existing.AdminNote = editingPage.AdminNote; existing.PageId = editingPage.PageId; existing.PageAccessToken = editingPage.PageAccessToken; existing.LastUpdated = DateTime.Now; }
        }
        await context.SaveChangesAsync();
        isEditingPage = false;
        LoadData();
        await JSRuntime.InvokeVoidAsync("alert", "✅ บันทึกข้อมูลเพจเรียบร้อยแล้ว");
    }

    async Task TogglePageStatus(ChangeEventArgs e)
    {
        if (selectedPage == null) return;
        bool status = (bool)e.Value;
        using var context = DbFactory.CreateDbContext();
        var page = context.FacebookPageConfigs.Find(selectedPage.Id);
        if (page != null)
        {
            page.IsActive = status;
            await context.SaveChangesAsync();
            LoadData();
            await JSRuntime.InvokeVoidAsync("alert", status ? "🟢 เปิดใช้งานบอทสำหรับเพจนี้แล้ว" : "🔴 ปิดการทำงานบอทแล้ว");
        }
    }

    async Task DeletePage()
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "ยืนยันลบเพจนี้? กฎการตอบกลับทั้งหมดจะหายไปด้วย");
        if (confirmed && selectedPage != null)
        {
            using var context = DbFactory.CreateDbContext();
            var p = context.FacebookPageConfigs.Find(selectedPage.Id);
            if (p != null) context.FacebookPageConfigs.Remove(p);
            await context.SaveChangesAsync();
            selectedPage = null;
            LoadData();
            await JSRuntime.InvokeVoidAsync("alert", "🗑️ ลบเพจเรียบร้อยแล้ว");
        }
    }

    void NewRule() { if (selectedPage == null) return; editingRule = new AutoReplyItem { FacebookPageConfigId = selectedPage.Id }; isEditingRule = true; }
    void EditRule(AutoReplyItem rule) { editingRule = new AutoReplyItem { Id = rule.Id, FacebookPageConfigId = rule.FacebookPageConfigId, Keywords = rule.Keywords, ReplyMessage = rule.ReplyMessage, IsActive = rule.IsActive }; isEditingRule = true; }

    async Task SaveRule()
    {
        using var context = DbFactory.CreateDbContext();
        if (editingRule.Id == 0) context.AutoReplyItems.Add(editingRule);
        else { var existing = context.AutoReplyItems.Find(editingRule.Id); if (existing != null) { existing.Keywords = editingRule.Keywords; existing.ReplyMessage = editingRule.ReplyMessage; } }
        await context.SaveChangesAsync();
        isEditingRule = false;
        LoadData();
    }

    async Task DeleteRule(AutoReplyItem rule)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "ลบคำตอบนี้?")) return;
        using var context = DbFactory.CreateDbContext();
        var item = context.AutoReplyItems.Find(rule.Id);
        if (item != null) { context.AutoReplyItems.Remove(item); await context.SaveChangesAsync(); LoadData(); }
    }

    async Task CopyToClipboard(string elementId)
    {
        await JSRuntime.InvokeVoidAsync("copyToClipboard", elementId);
    }
}