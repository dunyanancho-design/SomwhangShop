@page "/order-success/{OrderId}"
@using SomwhangShop.Models
@using SomwhangShop.Services
@inject OrderService OrderService
@inject IJSRuntime JSRuntime

<PageTitle>สั่งซื้อสำเร็จ | Somwhang Shop</PageTitle>

<div class="container py-5">
    @if (isLoading)
    {
        <div class="text-center py-5 fade-in">
            <div class="spinner-grow text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3 text-muted fw-light">กำลังจัดเตรียมใบเสร็จของคุณ...</p>
        </div>
    }
    else if (myOrder != null)
    {
        <div class="row justify-content-center fade-in-up">
            <div class="col-lg-6 col-md-8">
                <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                    <div class="card-header bg-success text-white text-center py-4 border-0 position-relative overflow-hidden">
                        <div class="position-relative z-1">
                            <i class="bi bi-check-circle-fill display-1 shadow-sm rounded-circle bg-white text-success"></i>
                            <h2 class="fw-bold mt-3">ขอบคุณสำหรับการสั่งซื้อ!</h2>
                            <p class="mb-0 opacity-75">เราได้รับข้อมูลเรียบร้อยแล้ว</p>
                        </div>
                        <div class="position-absolute top-0 start-0 w-100 h-100 bg-white opacity-10"
                             style="background-image: radial-gradient(circle, rgba(255,255,255,0.4) 1px, transparent 1px); background-size: 20px 20px;"></div>
                    </div>

                    <div class="card-body p-4 p-md-5 bg-white">

                        <div class="text-center mb-4">
                            <span class="text-muted small text-uppercase ls-1">Order ID</span>
                            <h4 class="fw-bold text-dark m-0" style="letter-spacing: 1px;">@myOrder.OrderId</h4>
                            <span class="badge bg-light text-dark border mt-2">@myOrder.OrderDate.ToString("dd MMM yyyy HH:mm")</span>
                        </div>

                        <div class="dashed-line my-4"></div>

                        <div class="row g-4">
                            <div class="col-sm-7">
                                <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-truck me-2"></i>ข้อมูลจัดส่ง</h6>
                                <p class="mb-1 fw-bold text-dark">@myOrder.CustomerName</p>
                                <p class="mb-1 small text-muted"><i class="bi bi-telephone me-1"></i> @myOrder.PhoneNumber</p>
                                <p class="mb-2 small text-muted text-break"><i class="bi bi-geo-alt me-1"></i> @myOrder.ShippingAddress</p>
                                <div class="d-inline-flex align-items-center bg-light px-2 py-1 rounded small text-secondary">
                                    <i class="bi bi-box-seam me-2"></i> จัดส่งโดย: <strong class="ms-1 text-dark">@myOrder.CourierName</strong>
                                </div>
                            </div>
                            <div class="col-sm-5 text-center text-sm-end">
                                <h6 class="fw-bold text-secondary mb-3">หลักฐานโอนเงิน</h6>
                                @if (!string.IsNullOrEmpty(myOrder.SlipImageUrl))
                                {
                                    <div class="position-relative d-inline-block group-hover-zoom">
                                        <a href="@myOrder.SlipImageUrl" target="_blank">
                                            <img src="@myOrder.SlipImageUrl" class="img-thumbnail rounded-3 shadow-sm"
                                                 style="width: 80px; height: 80px; object-fit: cover; cursor: zoom-in;"
                                                 alt="Slip" />
                                        </a>
                                        <div class="mt-1"><small class="text-success"><i class="bi bi-check-all"></i> ตรวจสอบแล้ว</small></div>
                                    </div>
                                }
                                else
                                {
                                    <div class="bg-light rounded-3 d-flex align-items-center justify-content-center mx-auto ms-sm-auto" style="width: 80px; height: 80px;">
                                        <i class="bi bi-image text-muted fs-4"></i>
                                    </div>
                                    <small class="text-muted d-block mt-1">ไม่มีรูปภาพ</small>
                                }
                            </div>
                        </div>

                        <div class="dashed-line my-4"></div>

                        <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-basket me-2"></i>รายการสินค้า</h6>
                        <ul class="list-unstyled mb-0">
                            @foreach (var item in myOrder.Items)
                            {
                                <li class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="d-flex align-items-center overflow-hidden">
                                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center text-secondary me-3 flex-shrink-0" style="width: 40px; height: 40px;">
                                            <span class="small fw-bold">x@(item.Quantity)</span>
                                        </div>
                                        <div class="text-truncate">
                                            <span class="fw-semibold text-dark d-block text-truncate">@item.Product.Name</span>
                                            <small class="text-muted">(@item.Product.Price.ToString("N0") / ชิ้น)</small>
                                        </div>
                                    </div>
                                    <span class="fw-bold text-dark flex-shrink-0">฿@((item.Product.Price * item.Quantity).ToString("N0"))</span>
                                </li>
                            }
                        </ul>

                        <div class="bg-light rounded-3 p-3 mt-4">
                            <div class="d-flex justify-content-between text-muted mb-2 small">
                                <span>ค่าจัดส่ง (@myOrder.CourierName)</span>
                                <span>฿@myOrder.ShippingCost.ToString("N2")</span>
                            </div>
                            <div class="border-top my-2"></div>
                            <div class="d-flex justify-content-between align-items-end">
                                <span class="fw-bold text-dark">ยอดสุทธิ</span>
                                <span class="fw-bolder text-primary fs-4">฿@myOrder.TotalAmount.ToString("N2")</span>
                            </div>
                        </div>

                        <div class="mt-5 d-grid gap-2">
                            <a href="/" class="btn btn-primary btn-lg rounded-pill shadow-sm py-3 transition-btn">
                                <i class="bi bi-bag-plus-fill me-2"></i>เลือกซื้อสินค้าต่อ
                            </a>
                        </div>
                        <div class="text-center mt-3">
                            <small class="text-muted">มีปัญหา? <a href="#" class="text-decoration-none">ติดต่อฝ่ายบริการลูกค้า</a></small>
                        </div>

                    </div>
                    <div class="card-footer bg-light py-2 border-0 text-center">
                        <small class="text-muted" style="font-size: 0.7rem;">Somwhang Shop &copy; @DateTime.Now.Year</small>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger text-center mx-auto shadow-sm rounded-4 p-5 fade-in" style="max-width: 500px;">
            <i class="bi bi-exclamation-circle text-danger display-4 mb-3"></i>
            <h4 class="fw-bold">ไม่พบข้อมูลคำสั่งซื้อ</h4>
            <p class="text-muted">รหัสคำสั่งซื้ออาจไม่ถูกต้อง หรือรายการยังไม่ถูกบันทึก</p>
            <a href="/" class="btn btn-outline-danger mt-3 rounded-pill px-4">กลับหน้าหลัก</a>
        </div>
    }
</div>

<style>
    /* Custom Styles for Smoother UI */
    .ls-1 {
        letter-spacing: 1px;
    }

    .dashed-line {
        border-bottom: 2px dashed #e9ecef;
    }

    /* Animation: Fade In */
    .fade-in {
        animation: fadeIn 0.8s ease-in-out;
    }

    /* Animation: Slide Up */
    .fade-in-up {
        animation: fadeInUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    /* Button Hover Effect */
    .transition-btn {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .transition-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(13, 110, 253, 0.3) !important;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    [Parameter] public string OrderId { get; set; } = "";
    private Order? myOrder;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        // จำลอง Delay นิดหน่อยเพื่อให้ Animation ทำงานและดูไม่กระตุก
        await Task.Delay(600);

        if (!string.IsNullOrEmpty(OrderId))
        {
            myOrder = await OrderService.GetOrderByIdAsync(OrderId);
        }
        isLoading = false;
    }
}