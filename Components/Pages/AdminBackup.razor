@page "/admin/backup"
@layout SomwhangShop.Components.Layout.AdminLayout
@using SomwhangShop.Services
@inject BackupService BackupService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<div class="container py-5 fade-in">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-primary text-white py-4 text-center">
            <i class="bi bi-safe2-fill display-3 mb-2"></i>
            <h3 class="fw-bold m-0">ระบบสำรองข้อมูลอัตโนมัติ</h3>
            <p class="mb-0 opacity-75">Database + รูปภาพ (เก็บย้อนหลัง 15 วัน)</p>
        </div>
        <div class="card-body text-center p-5">
            
            @if (isProcessing)
            {
                <div class="my-4">
                    <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status"></div>
                    <h5 class="mt-3 text-dark fw-bold animate-pulse">กำลังสำรองข้อมูล...</h5>
                    <p class="text-muted small">กรุณาอย่าปิดหน้านี้ ระบบกำลัง Zip ไฟล์ฐานข้อมูลและรูปภาพ</p>
                </div>
            }
            else
            {
                <div class="row justify-content-center">
                    <div class="col-md-8">
                        <div class="alert alert-info border-0 bg-info bg-opacity-10 rounded-3 text-start mb-4">
                            <h6 class="fw-bold text-info"><i class="bi bi-info-circle-fill me-2"></i>หลักการทำงาน:</h6>
                            <ul class="mb-0 small text-muted">
                                <li>ระบบจะสร้างไฟล์ <code>.zip</code> ที่รวม <strong>Database (.sql)</strong> และโฟลเดอร์ <strong>images</strong></li>
                                <li>ไฟล์จะถูกเก็บไว้ที่โฟลเดอร์ <code>wwwroot/backups</code> บน Server</li>
                                <li>ระบบจะ <strong>ลบไฟล์ที่เก่ากว่า 15 วัน</strong> ทิ้งอัตโนมัติเมื่อกดปุ่มนี้</li>
                            </ul>
                        </div>

                        <button class="btn btn-primary btn-lg rounded-pill px-5 py-3 shadow-lg hover-scale" @onclick="DoBackup">
                            <i class="bi bi-cloud-arrow-up-fill me-2 fs-4"></i> <span class="fs-5 fw-bold">เริ่มการสำรองข้อมูลเดี๋ยวนี้</span>
                        </button>

                        @if (!string.IsNullOrEmpty(lastBackupFile))
                        {
                            <div class="mt-4 animate-fade-up">
                                <div class="text-success fw-bold mb-2"><i class="bi bi-check-circle-fill me-1"></i> สำรองข้อมูลสำเร็จ!</div>
                                <a href="/backups/@lastBackupFile" class="btn btn-outline-success rounded-pill px-4" download>
                                    <i class="bi bi-download me-1"></i> ดาวน์โหลดไฟล์ล่าสุด (@lastBackupFile)
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .hover-scale:hover { transform: scale(1.05); transition: 0.3s; }
    .animate-pulse { animation: pulse 1.5s infinite; }
    .animate-fade-up { animation: fadeUp 0.5s ease-out; }
    @@keyframes pulse { 0% { opacity: 0.6; } 50% { opacity: 1; } 100% { opacity: 0.6; } }
    @@keyframes fadeUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

@code {
    bool isProcessing = false;
    string lastBackupFile = "";

    async Task DoBackup()
    {
        isProcessing = true;
        await Task.Delay(100); // UI update

        try
        {
            // เรียกใช้ Service ตัวใหม่
            lastBackupFile = await BackupService.CreateFullBackupAsync();
            await JSRuntime.InvokeVoidAsync("alert", "✅ สำรองข้อมูลเรียบร้อยแล้ว!");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"❌ เกิดข้อผิดพลาด: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }
}