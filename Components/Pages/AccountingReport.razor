@page "/admin/accounting"
@layout SomwhangShop.Components.Layout.AdminLayout
@using SomwhangShop.Models
@using SomwhangShop.Data
@using Microsoft.EntityFrameworkCore
@using OfficeOpenXml
@using OfficeOpenXml.Drawing
@using System.IO
@inject IDbContextFactory<SomwhangShopContext> DbFactory
@inject IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment
@rendermode InteractiveServer

<div class="container-fluid py-4 fade-in" style="max-width: 1800px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-primary mb-0"><i class="bi bi-journal-check me-2"></i>รายงานสรุปยอดขาย</h3>
            <p class="text-muted small mb-0">รายงานยอดขายพร้อมชื่อร้านสำหรับจัดส่ง</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-success shadow-sm" @onclick="ExportToExcel" disabled="@(orderList.Count == 0 || isLoading)">
                <i class="bi bi-file-earmark-excel me-1"></i> Export Excel
            </button>
        </div>
    </div>

    @* --- Dashboard Cards (คงเดิม) --- *@
    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="card border-start border-primary border-4 shadow-sm h-100"><div class="card-body"><h6 class="small fw-bold">รายรับสินค้าสุทธิ</h6><h3 class="fw-bold mb-0 text-primary">฿@TotalProductSales.ToString("N2")</h3></div></div></div>
        <div class="col-md-4"><div class="card border-start border-info border-4 shadow-sm h-100"><div class="card-body"><h6 class="small fw-bold">รายรับค่าขนส่ง</h6><h3 class="fw-bold mb-0 text-info">฿@TotalShippingCost.ToString("N2")</h3></div></div></div>
        <div class="col-md-4"><div class="card border-start border-success border-4 shadow-sm h-100"><div class="card-body"><h6 class="small fw-bold text-success">ยอดขายรวมทั้งหมด</h6><h3 class="fw-bold mb-0 text-success">฿@TotalGrandAmount.ToString("N2")</h3></div></div></div>
    </div>

    @* --- ตัวกรองวันที่ --- *@
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body bg-light rounded-3 p-3">
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-bold">จากวันที่</label>
                    <input type="date" class="form-control" @bind="startDate" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">ถึงวันที่</label>
                    <input type="date" class="form-control" @bind="endDate" />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-primary w-100" @onclick="LoadData">
                        <i class="bi bi-calculator me-1"></i> ประมวลผล
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* --- ตารางรายงาน --- *@
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead class="bg-dark text-white small">
                    <tr>
                        <th style="width: 80px;">สลิป</th>
                        <th style="width: 150px;">วันที่/เวลา</th>
                        <th>เลขที่ออเดอร์</th>

                        @* ✅ เปลี่ยนเป็นชื่อร้านแบบ Text ชัดเจน *@
                        <th class="text-primary bg-light" style="min-width: 150px;">ร้านค้า (สำหรับขนส่ง)</th>

                        <th class="text-start">ลูกค้า</th>
                        <th class="text-end">ยอดสินค้า</th>
                        <th class="text-end">ค่าส่ง</th>
                        <th class="text-end">ยอดโอนรวม</th>
                        <th>สถานะ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr><td colspan="9" class="py-5"><div class="spinner-border text-primary"></div></td></tr>
                    }
                    else if (orderList.Count == 0)
                    {
                        <tr><td colspan="9" class="py-5 text-muted">ไม่พบข้อมูลในช่วงเวลานี้</td></tr>
                    }
                    else
                    {
                        @foreach (var order in orderList)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(order.SlipImageUrl))
                                    {
                                        <img src="@GetSmartSlipUrl(order.SlipImageUrl)"
                                             class="rounded border shadow-sm img-thumbnail"
                                             style="width: 45px; height: 45px; cursor: pointer; object-fit: cover;"
                                             @onclick="() => OpenImage(GetSmartSlipUrl(order.SlipImageUrl))"
                                             onerror="this.src='https://placehold.co/50x50/png?text=Error';" />
                                    }
                                </td>
                                <td class="small">
                                    <div class="fw-bold">@order.OrderDate.ToString("dd/MM/yyyy")</div>
                                    <div class="text-muted">@order.OrderDate.ToString("HH:mm")</div>
                                </td>
                                <td class="fw-bold small font-monospace user-select-all">@order.OrderId</td>

                                @* ✅ แสดงชื่อร้านแบบ Text ล้วน (คลิกแล้วคลุมดำเลย) *@
                                <td class="bg-light">
                                    @{
                                        var shopName = order.OrderItems.FirstOrDefault()?.Product?.Shop?.Name ?? "-";
                                    }
                                    <span class="d-block fw-bold text-dark user-select-all cursor-copy" title="คลิกเพื่อ Copy">
                                        @shopName
                                    </span>
                                </td>

                                <td class="text-start">
                                    <div class="fw-bold small user-select-all">@order.CustomerName</div>
                                    <div class="text-muted small user-select-all">@order.PhoneNumber</div>
                                </td>
                                <td class="text-end">@((order.TotalAmount - order.ShippingCost).ToString("N2"))</td>
                                <td class="text-end text-muted">@order.ShippingCost.ToString("N2")</td>
                                <td class="text-end fw-bold text-success">@order.TotalAmount.ToString("N2")</td>
                                <td><span class="badge @(order.Status == "ยกเลิก" ? "bg-secondary" : "bg-success") rounded-pill px-3">@order.Status</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (showModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.8); z-index: 2000;" @onclick="CloseModal">
        <div class="modal-dialog modal-dialog-centered text-center">
            <img src="@modalImageUrl" class="img-fluid rounded shadow-lg" style="max-height: 85vh;" />
        </div>
    </div>
}

<style>
    /* CSS Helper ให้คลิกแล้วคลุมดำง่ายๆ */
    .user-select-all {
        user-select: all;
        -webkit-user-select: all;
    }

    .cursor-copy {
        cursor: text;
    }

        .cursor-copy:hover {
            background-color: #e9ecef;
            border-radius: 4px;
        }
</style>

@code {
    private DateTime startDate = DateTime.Today;
    private DateTime endDate = DateTime.Today;
    private List<Order> orderList = new();
    private bool isLoading = false;
    private decimal TotalProductSales = 0, TotalShippingCost = 0, TotalGrandAmount = 0;
    private bool showModal = false;
    private string modalImageUrl = "";

    protected override void OnInitialized() => LoadData();

    private void LoadData()
    {
        isLoading = true;
        try
        {
            using var context = DbFactory.CreateDbContext();
            var endOfDay = endDate.Date.AddDays(1).AddTicks(-1);

            // ✅ ดึงข้อมูลร้านค้า (Shop) มาด้วย
            var query = context.Orders
                .Include(o => o.OrderItems)
                    .ThenInclude(oi => oi.Product)
                    .ThenInclude(p => p.Shop)
                .AsQueryable()
                .Where(o => o.OrderDate >= startDate.Date && o.OrderDate <= endOfDay);

            query = query.Where(o => o.Status != "TEST" && o.Status != "รอตรวจสอบยอดเงิน" && o.Status != "Pending");
            orderList = query.OrderByDescending(o => o.OrderDate).ToList();

            // คำนวณยอดรวม
            TotalGrandAmount = orderList.Sum(o => o.TotalAmount);
            TotalShippingCost = orderList.Sum(o => o.ShippingCost);
            TotalProductSales = TotalGrandAmount - TotalShippingCost;
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
        finally { isLoading = false; }
    }

    private async Task ExportToExcel()
    {
        try { ExcelPackage.License.SetNonCommercialPersonal("SomwhangShop"); } catch { }

        using var package = new ExcelPackage();
        var sheet = package.Workbook.Worksheets.Add("Sales_Report");

        // ✅ Header: เอา "ร้านค้า" มาไว้คอลัมน์ 3 ให้เห็นชัดๆ
        string[] headers = { "วันที่", "ออเดอร์", "ร้านค้า (Sender)", "ลูกค้า (Receiver)", "ยอดสินค้า", "ค่าส่ง", "รวม", "สถานะ", "สลิป" };
        for (int i = 0; i < headers.Length; i++)
        {
            sheet.Cells[1, i + 1].Value = headers[i];
            sheet.Cells[1, i + 1].Style.Font.Bold = true;
            sheet.Cells[1, i + 1].Style.HorizontalAlignment = OfficeOpenXml.Style.ExcelHorizontalAlignment.Center;
            sheet.Cells[1, i + 1].Style.Fill.PatternType = OfficeOpenXml.Style.ExcelFillStyle.Solid;
            sheet.Cells[1, i + 1].Style.Fill.BackgroundColor.SetColor(System.Drawing.Color.LightGray);
        }

        int row = 2;
        foreach (var order in orderList)
        {
            sheet.Cells[row, 1].Value = order.OrderDate.ToString("dd/MM/yyyy HH:mm");
            sheet.Cells[row, 2].Value = order.OrderId;

            // ✅ ใส่ชื่อร้านเป็น Text ล้วนๆ (ไม่มีโลโก้)
            var shopName = order.OrderItems.FirstOrDefault()?.Product?.Shop?.Name ?? "-";
            sheet.Cells[row, 3].Value = shopName;

            sheet.Cells[row, 4].Value = order.CustomerName;
            sheet.Cells[row, 5].Value = order.TotalAmount - order.ShippingCost;
            sheet.Cells[row, 6].Value = order.ShippingCost;
            sheet.Cells[row, 7].Value = order.TotalAmount;
            sheet.Cells[row, 8].Value = order.Status;

            // จัดรูปแบบตัวเลข
            sheet.Cells[row, 5, row, 7].Style.Numberformat.Format = "#,##0.00";

            var imgPath = GetPhysicalSlipPath(order.SlipImageUrl);
            if (!string.IsNullOrEmpty(imgPath))
            {
                try
                {
                    var picture = sheet.Drawings.AddPicture($"Slip_{order.OrderId}", new FileInfo(imgPath));
                    picture.SetPosition(row - 1, 0, 8, 0); // คอลัมน์ที่ 9 (Index 8)
                    picture.SetSize(100, 150);
                    sheet.Row(row).Height = 115;
                }
                catch { }
            }
            row++;
        }

        sheet.Cells.AutoFitColumns();
        sheet.Column(9).Width = 20;

        var fileData = await package.GetAsByteArrayAsync();
        await JSRuntime.InvokeVoidAsync("saveAsFile", $"Somwhang_Report_{DateTime.Now:yyyyMMdd}.xlsx", Convert.ToBase64String(fileData));
    }

    private string GetSmartSlipUrl(string? url)
    {
        if (string.IsNullOrEmpty(url)) return "/images/placeholder.png";
        var cleanUrl = url.TrimStart('/');
        if (cleanUrl.StartsWith("images/slips", StringComparison.OrdinalIgnoreCase)) return "/" + cleanUrl;
        return $"/images/slips/{cleanUrl}?t={DateTime.Now.Ticks}";
    }

    private string? GetPhysicalSlipPath(string? url)
    {
        if (string.IsNullOrEmpty(url)) return null;
        var cleanUrl = url.TrimStart('/');
        if (!cleanUrl.StartsWith("images/slips", StringComparison.OrdinalIgnoreCase)) cleanUrl = "images/slips/" + cleanUrl;
        if (cleanUrl.Contains("?")) cleanUrl = cleanUrl.Split('?')[0];
        var fullPath = Path.Combine(Environment.WebRootPath, cleanUrl);
        return File.Exists(fullPath) ? fullPath : null;
    }

    private void OpenImage(string url) { modalImageUrl = url; showModal = true; }
    private void CloseModal() { showModal = false; modalImageUrl = ""; }
}